# Data-layer mode: which backend the app's apiRequest() talks to.
#   local    - the local-api dev server (default; see ../local-api/README.md).
#              Falls back to bundled offline data per-request if unreachable.
#   offline  - bundled demo dataset (src/api/demoDb.ts), no network calls.
#              This is what the shipped "preview" APK build sets, via the
#              legacy EXPO_PUBLIC_DEMO_MODE=true (still honored below).
#   mongodb  - the production FastAPI/Mongo backend (future).
EXPO_PUBLIC_API_MODE=local

# Origin of the API server (no trailing slash, no /api suffix — that's added
# automatically). Only used in "local"/"mongodb" mode. Defaults to
# http://localhost:3001 in "local" mode if unset.
# On a physical device, localhost is the phone itself — use your machine's LAN
# IP instead, e.g. http://192.168.1.42:3001, or the Android emulator's host
# alias http://10.0.2.2:3001.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# Legacy flag: forces "offline" mode regardless of EXPO_PUBLIC_API_MODE above.
# Still set by eas.json's "preview" build profile for the shipped APK.
# EXPO_PUBLIC_DEMO_MODE=true

# Allows plain http:// (Android cleartext) traffic. Read by app.config.js at
# build time to conditionally add the expo-build-properties plugin — leave
# unset/false everywhere except a LAN-IP dev build (eas.json's "lan-dev"
# profile sets this). The "hosted" profile talks to a real https:// server
# and must NOT set this.
# EXPO_PUBLIC_ALLOW_CLEARTEXT=true
