{
  "expo": {
    "name": "ମା ଓ ଶିଶୁ ସୁରକ୍ଷା",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.anctrackerapp.gneoey"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-foreground.png",
        "backgroundColor": "#B23F2E"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.anctrackerapp.gneoey.v2"
    },
    "web": {
      "name": "ମା ଓ ଶିଶୁ ସୁରକ୍ଷା",
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app uses your photos so you can attach a health slip to a pregnancy record.",
          "cameraPermission": "The app uses the camera so you can photograph a health slip for a pregnancy record."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7118d2ff-bab1-4c8e-baa5-1bd633b50455"
      }
    }
  }
}
